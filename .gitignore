# --- Python / uv ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- Secrets / local config ---
.env
.env.*
!.env.example
!.env.template

# --- Pipeline data (regenerated by the pipeline; 20 GB+ per season) ---
# video/ is committed only for its instructions; the videos themselves are never tracked
video/*
!video/README.md
!video/full_episodes/
video/full_episodes/*
!video/full_episodes/.gitkeep
work/
output/
logs/
data/

# --- Video ---
*.mkv
*.mp4
*.m4v
*.avi
*.mov
*.webm
*.ts
*.m2ts

# --- Images (screenshots, sampled frames, thumbnails) ---
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
*.tif
*.tiff
*.heic

# --- Model weights and caches (downloaded on demand from Hugging Face) ---
*.safetensors
*.pt
*.pth
*.bin
*.ckpt
*.gguf
*.onnx
*.h5
*.engine
*.mlpackage/
*.mlmodel
huggingface/
models/
.cache/

# --- Intermediate arrays / tables ---
*.npz
*.npy
*.parquet
*.feather
*.pkl
*.pickle
*.jsonl

# --- Generated deliverables ---
*.xlsx
*.xls
review.html

# --- OS / editor ---
