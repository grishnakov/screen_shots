# Copy to .env and fill in. .env is gitignored; never commit real keys.
#   cp .env.template .env

# --- VLM backend (any OpenAI-compatible chat endpoint that accepts images) ---
# Default: OpenRouter. Get a key at https://openrouter.ai/keys
VLM_BASE_URL=https://openrouter.ai/api/v1
VLM_MODEL=deepseek/deepseek-v4.1-flash
VLM_API_KEY=

# Local vLLM instead (Linux + NVIDIA only); no key needed:
# VLM_BASE_URL=http://127.0.0.1:8000/v1
# VLM_MODEL=model-under-test
# VLM_API_KEY=unused
